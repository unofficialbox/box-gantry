# VR-7 live smoke credentials (see runtimes/go/README.md).
#
# Copy to `.env` (gitignored) and fill in the flows you want to exercise:
#
#   cp .env.sample .env && edit .env
#   # Go runtime:
#   cd runtimes/go && go test -tags live -run TestLiveSmoke -v ./gantryruntime/...
#   # Rust runtime:
#   cd runtimes/rust/gantryruntime && cargo test --test livesmoke -- --ignored --nocapture
#
# Each smoke loads `.env` automatically (searching up from the test dir) and
# runs only the flows whose variables are set; with none set it skips.
# Real environment variables always take precedence over this file.
#
# NEVER commit a filled-in `.env`. Only this sample belongs in the repo.

# Developer Token — the simplest flow.
BOX_DEVELOPER_TOKEN=

# Client Credentials Grant (needs all three).
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_ENTERPRISE_ID=

# OAuth 2.0 — reuses CLIENT_ID/SECRET above plus a stored refresh token.
BOX_OAUTH_REFRESH_TOKEN=

# JWT — path to a Box box_config.json file.
BOX_JWT_CONFIG=
